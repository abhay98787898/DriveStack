# Database
DATABASE_URL="file:./drivecloud.db"

# Server
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Private DriveStack owner (exact Google sign-in email)
OWNER_EMAIL="your_google_email@gmail.com"

# Better Auth — private dashboard login
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate_a_random_secret_at_least_32_characters"

# Google OAuth — used for owner sign-in and separate Drive connection
# Add BOTH Authorized redirect URIs in the Google Cloud OAuth client:
# http://localhost:3000/api/auth/callback/google  (Better Auth dashboard login)
# http://localhost:3000/api/auth/google/callback  (Google Drive storage connection)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Security — encrypt separately stored Google Drive refresh tokens
ENCRYPTION_SECRET="generate_a_random_32_byte_hex_key"